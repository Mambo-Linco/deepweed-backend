# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database: Neon (free, does not expire) or local Postgres. FAKE example - replace with yours ----
DATABASE_URL=postgresql://neondb_owner:FAKE_PASSWORD@ep-fake-name-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ---- Login tokens (on Render this is generated for you) ----
JWT_SECRET=fake-jwt-secret-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- CORS: the web app address(es), comma separated. localhost ones are always allowed ----
ALLOWED_ORIGINS=https://deepweed-frontend.onrender.com

# ---- AI model service ----
ML_SERVICE_URL=https://deepweed-ml-service-1.onrender.com
# Shared secret: must be IDENTICAL in the model service. Leave empty for local use.
ML_API_KEY=fake-ml-key-change-me-0123456789
# ML_TIMEOUT_MS=90000

# ---- First admin account (created by the migration the first time it runs) ----
ADMIN_EMAIL=admin@deepweed.app
ADMIN_PASSWORD=Admin@1234