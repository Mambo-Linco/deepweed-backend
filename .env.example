# Server
PORT=5000
NODE_ENV=development

# Database (Neon or local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/deepweed

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS (comma separated). localhost:5173/5174/3000 are always allowed in addition.
ALLOWED_ORIGINS=http://localhost:5173

# Python AI model service (see ../ml-service)
ML_SERVICE_URL=http://localhost:8000
